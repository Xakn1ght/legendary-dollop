# AstroByte Bot Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ===========================================
# Telegram Bot Configuration
# ===========================================
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
ADMIN_USERNAME=your_telegram_username_here

# ===========================================
# Admin Panel Security
# ===========================================
# Generate password hash using: python -c "from app.core.settings import generate_password_hash; print(generate_password_hash('your_password'))"
ADMIN_PANEL_PASSWORD_HASH=your_argon2_hash_here
ADMIN_PANEL_SECRET_KEY=your_secret_key_here
ADMIN_2FA_ENABLED=true
# Free-text SQL runner on the admin Database page (/api/admin/db/query + /db/exec).
# OFF by default (endpoints 404, UI hides the SQL section) because it is an
# exfiltration surface on a public panel. Table/row browsing stays available.
# Set to 1 only while actively debugging, then turn it back off.
# Writes additionally require ADMIN_DB_DANGEROUS_SQL=1.
#ADMIN_DB_SQL_ENABLED=1

# ===========================================
# Marzban VPN Panel Configuration
# ===========================================
PASARGUARD_USERNAME=your_panel_admin_username
PASARGUARD_PASSWORD=your_panel_admin_password
PASARGUARD_BASE_URL=https://your-pasarguard-panel.com:9443
# Optional (PasarGuard 5.1+): static API key sent as X-Api-Key on every panel
# call; skips the admin-token login/refresh entirely. Create in panel UI
# (API Keys) or POST /api/api_key. Leave empty to use username/password.
PASARGUARD_API_KEY=

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database_name

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Public URLs
# ===========================================
DASHBOARD_PUBLIC_BASE_URL=https://your-dashboard-domain.com
GAME_PUBLIC_BASE_URL=https://your-game-domain.com

# ===========================================
# Payment Settings
# ===========================================
PAYMENT_CARD_NUMBER=6037-xxxx-xxxx-xxxx
PAYMENT_CARD_HOLDER=Your Name

# ===========================================
# Bank-SMS receipt auto-approval (optional)
# Keep each comment on its OWN line — the value is everything after '='.
# The user bot must be a member/admin of SMS_SOURCE_CHAT_ID so it can read the
# forwarded deposit SMS. OFF until a channel is set AND armed.
# ===========================================
# Channel/group id the SMS-forwarder posts into (e.g. -1001234567890)
SMS_SOURCE_CHAT_ID=
# 1 to arm at boot (also toggleable at runtime via the sms_state.json file)
SMS_AUTO_APPROVE=0
# Match a deposit to an order within this many seconds (2700 = 45 min)
SMS_MATCH_WINDOW_SEC=2700
# Keep unmatched deposits this long for late receipts (21600 = 6h)
SMS_DEPOSIT_TTL_SEC=21600
# Extra receiving-card last-4s (comma sep) beyond PAYMENT_CARD_NUMBER
SMS_DEST_CARD_LAST4=
# Shared claim DB so bakbot + ASTROBYTE never both approve one deposit
SMS_CLAIM_DB=/root/5a06b8e65bdb/sms_claims.sqlite3

# ── Free-AI receipt reader (optional, improves SMS matching) ────────────────
# Reads the customer's receipt image (any bank layout): source-card last-4 +
# reference numbers feed the deterministic matcher; ambiguous cases get an
# advisory hint DM. The AI never approves anything by itself.
# Get a free key at https://aistudio.google.com (Get API key) — ~1500 req/day.
GEMINI_API_KEY=
# Override the Gemini model if needed (default tries gemini-3-flash, then
# falls back to gemini-2.5-flash / gemini-2.0-flash automatically)
SMS_AI_MODEL=
# Fallback provider: https://openrouter.ai key (:free models, ~50 req/day)
OPENROUTER_API_KEY=
# OpenRouter model override (must be vision-capable)
OPENROUTER_MODEL=
